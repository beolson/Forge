# Copy to .env in the repository root and set each password before starting the stack.
# Use URL-safe characters for FORGE_DB_PASSWORD because it is used in DATABASE_URL.
POSTGRES_PASSWORD=
FORGE_DB_PASSWORD=
SEMAPHORE_DB_PASSWORD=
CLOUDBEAVER_ADMIN_PASSWORD=

SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@localhost
SEMAPHORE_ADMIN_PASSWORD=
# Generate with: head -c32 /dev/urandom | base64
# Keep this key when recreating containers or restoring Semaphore data.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
