# Copy to .env in the repository root and set each password before starting the stack.
# Use URL-safe characters for FORGE_DB_PASSWORD because it is used in DATABASE_URL.
POSTGRES_PASSWORD=
FORGE_DB_PASSWORD=
CLOUDBEAVER_ADMIN_PASSWORD=

# The Service Bus emulator also runs SQL Server Linux. Set Y only after
# accepting both Microsoft license terms linked in the local README.
SERVICEBUS_ACCEPT_EULA=
# Use a strong SQL Server password (at least 8 characters with mixed character types).
SERVICEBUS_SQL_PASSWORD=

# Forge Microsoft Entra sign-in (create a single-tenant Web app registration).
FORGE_ENTRA_TENANT_ID=
FORGE_ENTRA_CLIENT_ID=
FORGE_ENTRA_CLIENT_SECRET=
FORGE_AUTH_REDIRECT_URI=http://localhost:5321/auth/callback
# At least 32 random characters; keep stable across restarts and replicas.
FORGE_SESSION_SECRET=
FORGE_ADMIN_GROUP_ID=

# Real provider settings. Only privileged task containers receive these credentials.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_REGION=
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Absolute path to the GitHub App PEM file on the Docker host.
GITHUB_APP_PRIVATE_KEY_PATH=
# Separate source-loading GitHub App: Contents read only, installed only on Forge.
AUTOMATION_REPOSITORY=beolson/Forge
AUTOMATION_GITHUB_APP_ID=
AUTOMATION_GITHUB_INSTALLATION_ID=
AUTOMATION_GITHUB_PRIVATE_KEY_PATH=
# Explicit local development option before the new scripts are merged into main.
# Set /approved-source to snapshot the local runner source instead of fetching GitHub.
AUTOMATION_SOURCE_DIRECTORY=
# Default: 30 minutes per task attempt, with 3 total attempts owned by DBOS.
RUNNER_TASK_TIMEOUT_MS=1800000
RUNNER_LOG_RETENTION_DAYS=90
